<!DOCTYPE html>
<html lang="no">
{{> head}}

<body>
    {{> navbar}}

    {{#if msg}}
    <div class="alert alert-danger alert-dismissible" role="alert">
      <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      <strong>Error!</strong> {{msg}}
    </div>
    {{/if}}
    {{!-- If user exists: --}}
    {{#if user}}
    <div id="containerData" class="container-fluid">
      <h1 class="text-center">Laster bilder</h1>
    </div>

    <script type="text/javascript">
    var lastHash = document.location.hash;
    window.onpopstate = function(event) {
      var hash = document.location.hash;
      if (hash == "#album/" && hash != lastHash) {
        getAndRenderAlbums();
        lastHash = hash
      } else if (/#album\/\w+/.test(hash)) {
        lastHash = hash;
        loadAlbumId(hash.substring(7));
      }
    };
    getAndRenderAlbums();
    function getAndRenderAlbums() {
      window.location.hash = "#album/";
      var client = new HttpClient();
      client.get("/admin/album", true, function(response) {
        var res = JSON.parse(response);
        document.getElementById('containerData').innerHTML = `
        <h3 class="center-text">Trykk på et album for å se bildene</h3>
        <div class="row" id="containerData_AlbumRow"></div>

        `;

        for (var i = 0; i < res.data.length; i++) {
          // Get first image:
          document.getElementById('containerData_AlbumRow').innerHTML += `
          <div class="col-xs-6 col-md-3">
          <div class="thumbnail" onclick='loadAlbumId("${res.data[i]._id}")'>
          <img alt="${res.data[i].name}" id="${res.data[i]._id}Album">
          <div class="caption">
          <h3>${res.data[i].name}</h3>
          <p>${res.data[i].description}</p>
          </div>
          </div>
          </div>
          `;
          new HttpClient().get('/admin/bilde/' + res.data[i].imgs[0]._id, false, function(imgResponse) {
            document.getElementById(res.data[i]._id+'Album').setAttribute('src', "data:image/jpg;base64,"+imgResponse);
          });
        }
      });
    }

    function loadAlbumId(id) {
      window.location.hash = "#album/"+id;

      new HttpClient().get("/admin/album/"+id, true, function(response) {
        var res = JSON.parse(response);
        document.getElementById('containerData').innerHTML = `
        <button class="btn btn-default" onClick='getAndRenderAlbums("/admin/album")'><span class="glyphicon glyphicon-menu-left" aria-hidden="true"></span>Gå tilbake til album.</button>
        <h1 class="center-text">${res.data.name}</h1>
        <p class="center-text">${res.data.description}</p>
        `;
        for (var j = 0; j < res.data.imgs.length; j++) {
          new HttpClient().get('/admin/bilde/' + res.data.imgs[j]._id, true, function(image) {
            document.getElementById('containerData').innerHTML += `
            <div class="col-xs-6 col-sm-4 col-md-3">
              <img class="img-responsive img-thumbnail sb" href="data:image/jpg;base64,${image}" src="data:image/jpg;base64,${image}" onClick="largeImage(this)">
            </div>
            `;
          });
        }
      });
    }

      function HttpClient() {
        this.get = function(aUrl, asyncOrNah, aCallback) {
            var anHttpRequest = new XMLHttpRequest();
            anHttpRequest.onreadystatechange = function() {
                if (anHttpRequest.readyState == 4 && anHttpRequest.status == 200) aCallback(anHttpRequest.responseText);
            };

            anHttpRequest.open("GET", aUrl, asyncOrNah);
            anHttpRequest.send(null);
        };

        this.delete = function(aUrl, aCallback) {
            console.log("Delete");
            var anHttpRequest = new XMLHttpRequest();
            anHttpRequest.onreadystatechange = function() {
                if (anHttpRequest.readyState == 4 && anHttpRequest.status == 200) aCallback(anHttpRequest.responseText);
            };

            anHttpRequest.open("DELETE", aUrl, true);
            anHttpRequest.send(null);
        };

        this.put = function(aUrl, params, aCallback) {
            var anHttpRequest = new XMLHttpRequest();
            anHttpRequest.onreadystatechange = function() {
                if (anHttpRequest.readyState == 4 && anHttpRequest.status == 200) aCallback(anHttpRequest.responseText);
            };

            anHttpRequest.open("PUT", aUrl, true);
            anHttpRequest.setRequestHeader("Content-Type", "application/json");
            anHttpRequest.send(JSON.stringify(params));
        };
    };
  </script>

    {{else}}
    <section clas="center-text" id="adminLoginForm">
      <form class="" action="/foreldreportalLogin" method="post">
        <div class="form-group">
          <label for="usernameField">Brukernavn:</label>
          <p>La "foreldreportal" stå om du ikke er admin.</p>
          <input type="text" class="form-control" name="username" required placeholder="Brukernavn" value="foreldreportal">
        </div>
        <div class="form-group">
          <label for="passwordField">Passord:</label>
          <input type="password" class="form-control" name="password" required autofocus placeholder="Passord/kode">
        </div>
        <div class="form-group">
          <input type="submit" class="form-control" value="logg inn">
        </div>
      </form>
    </section>


    {{/if}}
    {{> footer}}
</body>

</html>
