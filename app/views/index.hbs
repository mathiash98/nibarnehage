<!DOCTYPE html>
<html lang="no">
{{> head}}

<body>
    {{> navbar}}
    <div class="row">
        <div class="col-lg-12">
          {{#if success_msg}}
            <div class="alert alert-success">{{success_msg}}</div>
          {{/if}}

          {{#if error_msg}}
            <div class="alert alert-danger">{{error_msg}}</div>
          {{/if}}

          {{#if error}}
            <div class="alert alert-danger">{{error}}</div>
          {{/if}}

        </div>


      </div>
    <div class="section center-text">

        <div id="frontPageCarousel" class="carousel slide" data-ride="carousel" data-interval="3000">
          <ol class="carousel-indicators">
            <li data-target="#frontPageCarousel" data-slide-to="0" class="active"></li>
            <li data-target="#frontPageCarousel" data-slide-to="1"></li>
            <li data-target="#frontPageCarousel" data-slide-to="2"></li>
            <li data-target="#frontPageCarousel" data-slide-to="3"></li>
            <li data-target="#frontPageCarousel" data-slide-to="4"></li>
            <li data-target="#frontPageCarousel" data-slide-to="5"></li>
            <li data-target="#frontPageCarousel" data-slide-to="6"></li>
            <li data-target="#frontPageCarousel" data-slide-to="7"></li>
            <li data-target="#frontPageCarousel" data-slide-to="8"></li>
            <li data-target="#frontPageCarousel" data-slide-to="9"></li>
          </ol>

          <div class="carousel-inner" role="listbox">
            <div class="item active">
              <img class="sb" src="/img/Ute.jpg" class="img-responsive center-block" alt="Uteområde">
              <div class="carousel-caption">Uteområde</div>
            </div>
            <div class="item">
              <img class="sb" src="/img/Sanserommet.jpg" class="img-responsive center-block" alt="Sanserommet">
              <div class="carousel-caption">Sanserommet</div>
            </div>
            <div class="item">
              <img class="sb" src="/img/NIBarnehage Kylling (1).jpg" class="img-responsive center-block" alt="Kylling">
              <div class="carousel-caption">Vi klekker kyllinger hvert år</div>
            </div>
            <div class="item">
              <img class="sb" src="/img/Biler og togbaner.jpg" class="img-responsive center-block" alt="Biler og togbaner">
              <div class="carousel-caption">Biler og togbaner</div>
            </div>
            <div class="item">
              <img class="sb" src="/img/Familiekrok.jpg" class="img-responsive center-block" alt="Familiekrok">
              <div class="carousel-caption">Familiekrok</div>
            </div>
            <div class="item">
              <img class="sb" src="/img/Garderobe.jpg" class="img-responsive center-block" alt="Garderobe">
              <div class="carousel-caption">Garderobe</div>
            </div>
            <div class="item">
              <img class="sb" src="/img/Konstruksjonsleker og dyr.jpg" class="img-responsive center-block" alt="Konstruksjonsleker og dyr">
              <div class="carousel-caption">Konstruksjonsleker og dyr</div>
            </div>
            <div class="item">
              <img class="sb" src="/img/NIBarnehage lekeomrade (2).jpg" class="img-responsive center-block" alt="Lekeområde">
              <div class="carousel-caption"></div>
            </div>
            <div class="item">
              <img class="sb" src="/img/Oversikt inne 1.jpg" class="img-responsive center-block" alt="Inneområde">
              <div class="carousel-caption">Oversikt inneomrade</div>
            </div>
            <div class="item">
              <img class="sb" src="/img/Oversikt inne 2.jpg" class="img-responsive center-block" alt="Inneområde">
              <div class="carousel-caption">Oversikt inneområde</div>
            </div>
          </div><a class="left carousel-control" href="#frontPageCarousel" role="button" data-slide="prev"><span class="glyphicon glyphicon-chevron-left" aria-hidden="true"></span><span class="sr-only">Previous</span></a><a class="right carousel-control"
          href="#frontPageCarousel" role="button" data-slide="next"><span class="glyphicon glyphicon-chevron-right" aria-hidden="true"></span><span class="sr-only">Next</span></a>

        </div>
    </div>
    <br>

    <div class="section center-text ">
      <div class="container">
        <h1>Hvorfor velge Nesttun Indremisjons Barnehage</h1>
        <div class="divider"></div>
        <div class="row center-block">
          <div class="col-md-4 center-text">
            <p>{{breaklines textBox1.data}}</p>
          </div>
          <div class="col-md-4 center-text">
            <p>{{breaklines textBox2.data}}</p>
          </div>
          <div class="col-md-4 center-text">
            <p>{{breaklines textBox3.data}}</p>
          </div>
        </div>
      </div>
    </div>
    <div id="quote_section" class="section center-text container-fluid">
      <div class="container">
        <img src="img/quote_icon.png" alt="quote_icon" width="100vw">
        <p class="quote_text">{{breaklines sitat.data}}</p>

      </div>
    </div>

    <div id="_section" class="section center-text container-fluid">
      <div class="container">
        <p>{{breaklines textBox5.data}}</p>

      </div>
    </div>

    <div id="quick_contact_section" class="container-fluid">
      <div class="container center-text">
        <div class="row">
          <div class="col-md-4 vcenter">
            <div height="2em">
              <p><span class="glyphicon glyphicon-map-marker"></span> Øvsttunveien 58 5223 Nesttun</p>
              <p><span class="glyphicon glyphicon-earphone"></span> 55 10 07 24</p>
              <p><span class="glyphicon glyphicon-envelope"></span> nesttun.barnehage@indrem.no</p>

            </div>
          </div><!--
          --><div class="col-md-8 vcenter">
          <iframe width="100%" height="350" src="https://www.openstreetmap.org/export/embed.html?bbox=5.361714363098145%2C60.30986475435649%2C5.364764034748078%2C60.311177308267766&amp;layer=mapnik&amp;marker=60.310521037904415%2C5.363239198923111" style="border: 1px solid black"></iframe><br/><small><a href="https://www.openstreetmap.org/?mlat=60.31052&amp;mlon=5.36324#map=19/60.31052/5.36324">View Larger Map</a></small>
        </div>
      </div>
      </div>
    </div>


    {{> footer}}
</body>

</html>
