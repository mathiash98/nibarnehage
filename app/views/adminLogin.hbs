<!DOCTYPE html>
<html lang="en">
{{> head}}

<body>
    {{> navbar}}
        <section clas="center-text" id="adminLoginForm">
            <form class="" action="/login" method="post">
                <div class="form-group">
                    <label for="usernameField">Brukernavn</label>
                    <input type="text" class="form-control" name="username" required autofocus placeholder="brukernavn">
                </div>
                <div class="form-group">
                    <label for="passwordField">Passord</label>
                    <input type="password" class="form-control" name="password" required placeholder="passord">
                </div>
                <div class="form-group">
                    <input type="submit" class="form-control" value="logg inn">
                </div>
            </form>
        </section>

    {{> footer}}
</body>

</html>
