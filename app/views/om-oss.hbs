<!DOCTYPE html>
<html lang="no">
{{> head}}

<body>
    {{> navbar}}
    <div class="">
      <!-- Container -->
      <iframe width="100%" height="350" src="https://www.openstreetmap.org/export/embed.html?bbox=5.357326269149781%2C60.30792771105107%2C5.369524955749513%2C60.313167294471164&amp;layer=mapnik&amp;marker=60.31054760781083%2C5.363425612449646" style="border: 1px solid black"></iframe><br/><small><a href="https://www.openstreetmap.org/?mlat=60.31055&amp;mlon=5.36343#map=17/60.31055/5.36343">View Larger Map</a></small>
    </div>
    <div class="container-fluid">

        <div class="row center-block">

            <div class="col-xs-12 col-sm-4 center-text">
                <div class="">
                    <h3><span class="glyphicon glyphicon-map-marker"></span> Besøks- og kontaktadresse</h3>
                    <p>Øvsttunveien 58 5223 Nesttun</p>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 center-text">
                <div class="">
                    <h3><span class="glyphicon glyphicon-time"></span> Åpningstid</h3>
                    <p>07:15-16:30</p>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 center-text">
              <div class="">
                <h3><span class="glyphicon glyphicon-earphone"></span> Telefon og <span class="glyphicon glyphicon-envelope"></span> Mail</h3>
                <p>55 10 07 24</p>
                <p>nesttun.barnehage@indrem.no</p>
              </div>
            </div>

        </div>
        <!-- row -->
    </div>
    <div class="divider"></div>
    <div id="lightgallery" class="section container-fluid">
      <div class="container om-oss-container">
        <h1>Om oss</h1>

        <div class="divider"></div>
        <div class="row">
          <div class="col-sm-6">
            <p>{{breaklines textBox1.data}}</p>
          </div>
          <div class="col-sm-6">
            <img class="sb" src="/img/Ute.jpg" class="img-responsive center-block" alt="Uteområde">
          </div>
        </div>

        <div class="divider"></div>
        <div class="row">
          <div class="col-sm-6">
            <img class="sb" src="/img/NIBarnehage Skoytebane.jpg" alt="Skøytebane">
          </div>
          <div class="col-sm-6">
            <p>{{breaklines textBox2.data}}</p>
          </div>
        </div>

        <div class="divider"></div>
        <div class="row">
          <div class="col-sm-6">
            <p>{{breaklines textBox3.data}}</p>
            <p><a href="/planer">Trykk her for å lese Nesttun Indremisjons Barnehage sine vedtekter og planer.</a></p>
          </div>
          <div class="col-sm-6">
            <img class="sb" src="/img/NIBarnehage Kylling (1).jpg" alt="Kylling">
          </div>
        </div>

      </div>
    </div>
    {{> footer}}
</body>

</html>
