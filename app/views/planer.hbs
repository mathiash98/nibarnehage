<!DOCTYPE html>
<html lang="no">
{{> head}}

<body>
    {{> navbar}}
    <div class="container">
      <div class="row">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Filnavn</th>
              <th>Dato</th>
            </tr>
          </thead>
          <tbody id="filesTableBody">
            {{#each files}}
            <tr>
              <td>
                <a href="/planer/{{_id}}" target="blank">{{filename}}</a>
              </td>
              <td class="dateTime">
                {{uploadDate}}
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>


    <script type="text/javascript">
      var timeObjects = document.getElementsByClassName("dateTime");
      for (var i = 0; i < timeObjects.length; i++) {
        timeObjects[i].innerHTML = timeObjects[i].innerHTML.substring(21,32);
      }
    </script>

    {{> footer}}
</body>

</html>
